    "source_html": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<title>每个镜头，都能再调整</title>\n<style>\n  html,body{margin:0;padding:0;overflow:hidden;background:#ffffff;}\n  #stage{position:relative;width:1280px;height:720px;overflow:hidden;background:#ffffff;\n    font-family:'PingFang SC','Arial',sans-serif;}\n  .abs{position:absolute;}\n  .title{left:0;width:1280px;text-align:center;color:#0B3C78;\n    font-size:44px;font-weight:600;letter-spacing:2px;}\n  .label{color:#1668C9;font-size:28px;font-weight:500;letter-spacing:1px;white-space:nowrap;}\n  .sub{color:#3B6EA8;font-size:28px;font-weight:400;letter-spacing:1px;white-space:nowrap;}\n  .closing{left:0;width:1280px;text-align:center;color:#0B3C78;font-size:52px;font-weight:600;letter-spacing:3px;}\n  .seg{position:absolute;background:#EAF2FC;border:2px solid #1668C9;border-radius:8px;box-sizing:border-box;}\n  .seg-sel{background:#DCEBFC;border-width:4px;}\n  .seg-new{background:#EAF2FC;border:2px dashed #1668C9;}\n  .seg-deep{background:#1668C9;border-color:#0B3C78;}\n  .seg-deep-label{position:absolute;color:#ffffff;font-size:26px;font-weight:500;letter-spacing:1px;}\n  .timeline{position:absolute;height:2px;background:#BBD3EE;}\n  .tick{position:absolute;width:2px;height:14px;background:#BBD3EE;}\n  #capLine{position:absolute;height:2px;background:#1668C9;}\n  #capText{position:absolute;color:#0B3C78;font-size:30px;font-weight:400;letter-spacing:1px;white-space:nowrap;}\n  .arrowhead{position:absolute;width:0;height:0;}\n</style>\n</head>\n<body>\n<div id=\"stage\">\n  <div id=\"title\" class=\"abs title\">每个镜头，都能再调整</div>\n\n  <div id=\"tlLine\" class=\"timeline\"></div>\n  <div id=\"tlTick1\" class=\"tick\"></div>\n  <div id=\"tlTick2\" class=\"tick\"></div>\n  <div id=\"tlTick3\" class=\"tick\"></div>\n\n  <div id=\"seg1\" class=\"seg\"></div>\n  <div id=\"seg2\" class=\"seg seg-sel\"></div>\n  <div id=\"seg3\" class=\"seg\"></div>\n  <div id=\"seg4\" class=\"seg seg-new\"></div>\n\n  <div id=\"deepLabel\" class=\"seg-deep-label\">镜头</div>\n\n  <div id=\"durArrowL\" class=\"abs\"></div>\n  <div id=\"durArrowR\" class=\"abs\"></div>\n  <div id=\"durLabel\" class=\"abs label\">时长</div>\n\n  <div id=\"capLine\" class=\"abs\"></div>\n  <div id=\"capText\" class=\"abs\"></div>\n  <div id=\"capLabel\" class=\"abs label\">字幕</div>\n\n  <div id=\"loopIcon\" class=\"abs\"></div>\n  <div id=\"repLabel\" class=\"abs label\">替换镜头</div>\n\n  <div id=\"closing\" class=\"abs closing\">从一个想法，到下一部片子</div>\n</div>\n<script>\n(function(){\n  var stage = document.getElementById('stage');\n\n  var titleEl = document.getElementById('title');\n  var tlLine = document.getElementById('tlLine');\n  var ticks = [document.getElementById('tlTick1'),document.getElementById('tlTick2'),document.getElementById('tlTick3')];\n  var seg1 = document.getElementById('seg1');\n  var seg2 = document.getElementById('seg2');\n  var seg3 = document.getElementById('seg3');\n  var seg4 = document.getElementById('seg4');\n  var deepLabel = document.getElementById('deepLabel');\n  var durArrowL = document.getElementById('durArrowL');\n  var durArrowR = document.getElementById('durArrowR');\n  var durLabel = document.getElementById('durLabel');\n  var capLine = document.getElementById('capLine');\n  var capText = document.getElementById('capText');\n  var capLabel = document.getElementById('capLabel');\n  var loopIcon = document.getElementById('loopIcon');\n  var repLabel = document.getElementById('repLabel');\n  var closingEl = document.getElementById('closing');\n\n  // ---- base geometry ----\n  var TL_Y = 372;            // timeline y\n  var TL_X = 230;            // timeline start x\n  var TL_W = 820;            // timeline width\n  var SEG_H = 58;\n  var SEG_Y = TL_Y - SEG_H - 22;   // segments sit above line\n\n  var S1_X = 280, S1_W = 170;\n  var S2_X = 500, S2_W = 240;      // selected, grows to 320\n  var S3_X = 800, S3_W = 190;\n  var GROW = 80;                    // duration extension\n\n  var SEG1_Y = SEG_Y;\n\n  // timeline elements\n  tlLine.style.left = TL_X+'px';\n  tlLine.style.top = TL_Y+'px';\n  tlLine.style.width = TL_W+'px';\n  var tickXs = [TL_X, TL_X + TL_W/2, TL_X + TL_W];\n  for(var i=0;i<3;i++){\n    ticks[i].style.left = tickXs[i]+'px';\n    ticks[i].style.top = (TL_Y-6)+'px';\n  }\n\n  seg1.style.top = SEG1_Y+'px';\n  seg2.style.top = SEG1_Y+'px';\n  seg3.style.top = SEG1_Y+'px';\n  seg4.style.top = SEG1_Y+'px';\n\n  // deep label inside seg2\n  deepLabel.style.top = (SEG1_Y + 15)+'px';\n  deepLabel.style.left = (S2_X + 22)+'px';\n\n  // duration label above seg2 right edge\n  durLabel.style.top = (SEG1_Y - 52)+'px';\n\n  // caption line below seg2\n  var CAP_Y = TL_Y + 46;\n  capLine.style.left = (S2_X + 20)+'px';\n  capLine.style.top = CAP_Y+'px';\n  capLine.style.width = (S2_W - 40)+'px';\n\n  capText.style.left = (S2_X + 30)+'px';\n  capText.style.top = (CAP_Y + 16)+'px';\n  capText.textContent = '';\n\n  capLabel.style.left = (S2_X + 30)+'px';\n  capLabel.style.top = (CAP_Y + 70)+'px';\n\n  // replace label to right of seg2 near new seg\n  repLabel.style.left = '620px';\n  repLabel.style.top = (SEG1_Y + 16)+'px';\n\n  // loop icon (SVG) inside seg2\n  loopIcon.innerHTML =\n    '<svg width=\"44\" height=\"44\" viewBox=\"0 0 44 44\">'+\n    '<path d=\"M12 18 A12 12 0 1 1 12 30\" fill=\"none\" stroke=\"#0B3C78\" stroke-width=\"3\" stroke-linecap=\"round\"/>'+\n    '<polygon points=\"12,11 12,25 23,18\" fill=\"#0B3C78\"/>'+\n    '</svg>';\n  loopIcon.style.left = (S2_X + S2_W/2 - 22)+'px';\n  loopIcon.style.top = (SEG1_Y + SEG_H/2 - 22)+'px';\n\n  // duration arrowheads drawn as SVG-ish triangles via clip-path boxes\n  durArrowL.innerHTML = '<svg width=\"20\" height=\"26\" viewBox=\"0 0 20 26\"><polygon points=\"18,2 18,24 2,13\" fill=\"#1668C9\"/></svg>';\n  durArrowR.innerHTML = '<svg width=\"20\" height=\"26\" viewBox=\"0 0 20 26\"><polygon points=\"2,2 2,24 18,13\" fill=\"#1668C9\"/></svg>';\n\n  // ---- easing ----\n  function clamp01(x){ return x<0?0:(x>1?1:x); }\n  function easeOutCubic(x){ x=clamp01(x); return 1-Math.pow(1-x,3); }\n  function easeInOutSine(x){ x=clamp01(x); return -(Math.cos(Math.PI*x)-1)/2; }\n  function seg(a,b,t){ return clamp01((t-a)/(b-a)); }\n\n  function setOp(el,o){ el.style.opacity = o; }\n\n  function render(t){\n    t = Math.max(0, Math.min(10, t));\n\n    // ---------------- title ----------------\n    var tIn = easeOutCubic(seg(0.0,0.8,t));\n    var tOut = easeOutCubic(seg(7.3,8.0,t));\n    titleEl.style.top = (34 + (1-tIn)*22 - tOut*30)+'px';\n    titleEl.style.opacity = String(tIn * (1-tOut));\n\n    // ---------------- timeline + segments enter ----------------\n    var tlIn = easeOutCubic(seg(0.5,1.4,t));\n    var tlOut = easeOutCubic(seg(7.3,8.0,t));\n    var tlAlpha = tlIn*(1-tlOut);\n    var tlShift = -tlOut*40;\n    tlLine.style.opacity = String(tlAlpha);\n    tlLine.style.transform = 'scaleX('+tlIn+') translateY('+tlShift+'px)';\n    tlLine.style.transformOrigin = 'left center';\n    for(var i=0;i<3;i++){\n      ticks[i].style.opacity = String(tlAlpha);\n      ticks[i].style.transform = 'translateY('+tlShift+'px)';\n    }\n\n    // base segment positions\n    var s1in = easeOutCubic(seg(0.9,1.7,t));\n    var s2in = easeOutCubic(seg(1.0,1.8,t));\n    var s3in = easeOutCubic(seg(1.1,1.9,t));\n\n    // duration growth of seg2: 2.5 -> 3.8\n    var grow = easeInOutSine(seg(2.5,3.8,t)) * GROW;\n    var s2w = S2_W + grow;\n\n    // replace action 7.5 -> 8.6: seg2 deepens, new segment slides in from right of seg2\n    var repl = easeInOutSine(seg(7.5,8.6,t));\n    // compressed shift: seg3 slides right to make room for new seg, then new seg arrives\n    var s3shift = easeInOutSine(seg(7.5,8.5,t)) * 0;\n\n    // final fade of timeline group at 7.9 - 8.6 partly overlapping; but keep visible until 8.0\n    var groupOut = easeOutCubic(seg(7.9,8.7,t));\n    var groupAlpha = (1-groupOut);\n\n    function placeSeg(el, x, w, inP, alphaMul){\n      el.style.left = x+'px';\n      el.style.width = w+'px';\n      el.style.height = SEG_H+'px';\n      var a = inP*(alphaMul===undefined?1:alphaMul)*groupAlpha;\n      el.style.opacity = String(clamp01(a));\n      el.style.transform = 'translateY('+((1-inP)*16 + tlShift)+'px)';\n    }\n\n    placeSeg(seg1, S1_X, S1_W, s1in);\n    placeSeg(seg2, S2_X, s2w, s2in);\n    placeSeg(seg3, S3_X + s3shift, S3_W, s3in);\n\n    // deep color on seg2 at replace time\n    var deepT = easeOutCubic(seg(7.6,8.3,t));\n    // seg2 background interpolate #DCEBFC -> #1668C9\n    var r1=220,g1=235,b1=252, r2=22,g2=104,b2=201;\n    var rr = Math.round(r1+(r2-r1)*deepT);\n    var gg = Math.round(g1+(g2-g1)*deepT);\n    var bb = Math.round(b1+(b2-b1)*deepT);\n    seg2.style.background = 'rgb('+rr+','+gg+','+bb+')';\n    seg2.style.borderColor = deepT>0.5 ? '#0B3C78' : '#1668C9';\n\n    // deep label fades in when deep starts\n    var dlIn = easeOutCubic(seg(7.7,8.3,t));\n    deepLabel.style.opacity = String(dlIn*groupAlpha*0.95);\n    deepLabel.style.transform = 'translateY('+((1-dlIn)*8)+'px)';\n\n    // loop icon inside seg2: 7.5 in, 8.4 out\n    var lIn = easeOutCubic(seg(7.4,8.0,t));\n    var lOut = easeOutCubic(seg(8.2,8.7,t));\n    loopIcon.style.opacity = String(lIn*(1-lOut)*groupAlpha);\n    loopIcon.style.transform = 'rotate('+((1-lIn)*0 + lOut*90)+'deg) scale('+(0.6+0.4*lIn)+')';\n    loopIcon.style.display = 'block';\n\n    // new segment (seg4) slides in from right of seg2\n    var nIn = easeOutCubic(seg(7.8,8.6,t));\n    var seg4X = S2_X + s2w + 26;\n    placeSeg(seg4, seg4X, 150, nIn);\n    // its dashed border become normal?\n    seg4.style.opacity = String(clamp01(nIn*groupAlpha));\n    seg4.style.transform = 'translateX('+((1-nIn)*60)+'px) translateY('+tlShift+'px)';\n\n    renderDuration(t, grow, groupAlpha, tlShift);\n    renderCaption(t, groupAlpha, tlShift);\n    renderReplaceLabel(t, groupAlpha, tlShift);\n    renderClosing(t);\n  }\n\n  function renderDuration(t, grow, groupAlpha, shift){\n    // arrow appears 2.3 -> 2.9, extends with grow\n    var aIn = easeOutCubic(seg(2.3,2.9,t));\n    var aOut = easeOutCubic(seg(4.6,5.1,t));\n    var a = aIn*(1-aOut)*groupAlpha;\n\n    var baseRight = S2_X + S2_W + grow;  // right edge of seg2\n    var midY = SEG1_Y + SEG_H/2;\n    var armLen = 58;\n    // two-headed arrow centered on right edge\n    durArrowL.style.left = (baseRight - armLen - 10)+'px';\n    durArrowL.style.top = (midY - 13)+'px';\n    durArrowL.style.opacity = String(a);\n    var shake = 1 + 0.0;\n\n    durArrowR.style.left = (baseRight + 10)+'px';\n    durArrowR.style.top = (midY - 13)+'px';\n    durArrowR.style.opacity = String(a);\n\n    // a thin line connecting the two arrowheads\n    // (use durLabel line via border) - draw with durArrowL/R; add small connector\n    var conn = document.getElementById('durConn');\n    if(!conn){\n      conn = document.createElement('div');\n      conn.id='durConn';\n      conn.className='abs';\n      conn.style.height='2px';\n      conn.style.background='#1668C9';\n      stage.appendChild(conn);\n    }\n    conn.style.left = (baseRight - armLen)+'px';\n    conn.style.top = (midY-1)+'px';\n    conn.style.width = (armLen*2)+'px';\n    conn.style.opacity = String(a*0.8);\n\n    var lbIn = easeOutCubic(seg(2.5,3.1,t));\n    var lbOut = easeOutCubic(seg(4.6,5.1,t));\n    var la = lbIn*(1-lbOut)*groupAlpha;\n    durLabel.style.left = (baseRight - 34)+'px';\n    durLabel.style.top = (SEG1_Y - 50 + (1-lbIn)*10)+'px';\n    durLabel.style.opacity = String(la);\n  }\n\n  function renderCaption(t, groupAlpha, shift){\n    // caption line 5.0 -> 7.5ish\n    var liIn = easeOutCubic(seg(4.9,5.4,t));\n    var liOut = easeOutCubic(seg(7.4,7.9,t));\n    var la = liIn*(1-liOut)*groupAlpha;\n    capLine.style.opacity = String(la);\n    capLine.style.transform = 'scaleX('+liIn+')';\n    capLine.style.transformOrigin = 'left center';\n\n    var full = '镜头，可以再调整';\n    // typed from 5.5 to 7.0\n    var p = easeInOutSine(seg(5.5,7.0,t));\n    var n = Math.round(p * full.length);\n    capText.textContent = full.slice(0, n);\n    capText.style.opacity = String(clamp01(p*2)*groupAlpha);\n\n    var lbIn = easeOutCubic(seg(5.1,5.6,t));\n    var lbOut = easeOutCubic(seg(7.4,7.9,t));\n    capLabel.style.opacity = String(lbIn*(1-lbOut)*groupAlpha);\n    capLabel.style.transform = 'translateY('+((1-lbIn)*10)+'px)';\n\n    var clOut = easeOutCubic(seg(7.7,8.2,t));\n    capText.style.opacity = String(clamp01(p*2)*groupAlpha*(1-clOut*0.9));\n    capLabel.style.opacity = String(lbIn*(1-lbOut)*groupAlpha);\n  }\n\n  function renderReplaceLabel(t, groupAlpha, shift){\n    var lIn = easeOutCubic(seg(7.5,8.0,t));\n    var lOut = easeOutCubic(seg(8.5,9.0,t));\n    var a = lIn*(1-lOut)*groupAlpha;\n    repLabel.style.opacity = String(a);\n    repLabel.style.transform = 'translateY('+((1-lIn)*12)+'px)';\n  }\n\n  function renderClosing(t){\n    var cIn = easeOutCubic(seg(8.5,9.3,t));\n    var hold = easeInOutSine(seg(9.0,9.6,t));\n    closingEl.style.opacity = String(cIn);\n    closingEl.style.top = (322 + (1-cIn)*18)+'px';\n    // subtle underline growth\n    var ul = document.getElementById('closeUnderline');\n    if(!ul){\n      ul = document.createElement('div');\n      ul.id='closeUnderline';\n      ul.className='abs';\n      ul.style.height='3px';\n      ul.style.background='#1668C9';\n      ul.style.borderRadius='2px';\n      stage.appendChild(ul);\n    }\n    var w = 360 * easeOutCubic(seg(8.9,9.6,t));\n    ul.style.width = w+'px';\n    ul.style.left = (640 - w/2)+'px';\n    ul.style.top = (392)+'px';\n    ul.style.opacity = String(seg(8.9,9.4,t));\n  }\n\n  window.renderAt = render;\n  render(0);\n})();\n</script>\n</body>\n</html>",
